#! /usr/bin/env bash

# shellcheck source=/dev/null
# shellcheck disable=SC2016,SC2139

add-alias() {  
	alias "$1"="$2"
}

# ---------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------

add-alias s                   'source ~/.bashrc'
add-alias ts                  'date +%Y-%m-%d_%Hh%Mm%Ss'

# ---------------------------------------------------------------------
# Shell
# ---------------------------------------------------------------------

add-alias ..                  "cd .."
add-alias ...                 "cd ../.."
add-alias hgrep               "history | grep"
add-alias ll                  "ls -lh"
add-alias la                  "ls -alh"

# ---------------------------------------------------------------------
# Git Tool
# ---------------------------------------------------------------------

add-alias got                 'git '
add-alias get                 'git '
add-alias gt                  'git '
add-alias gs                  'git status'
add-alias ga                  'git add'
add-alias gaa                 'git add $(gtlsunst)'
add-alias gb                  'git branch'
add-alias gc                  'git commit'
add-alias gca                 'git commit --amend --no-edit'
add-alias gk                  'gitk --all&'
add-alias gits                'git status -uno'
add-alias gd                  'gitdifftool'
add-alias gtunst              'git reset HEAD'
add-alias gtunco              'git checkout --'
add-alias gitcompare          'git difftool -d HEAD~1 HEAD'
add-alias gtls                'gtls.sh --tracked'
add-alias gtlstr              'gtls.sh --tracked'
add-alias gtlsuntr            'gtls.sh --untracked'
add-alias gtlsst              'gtls.sh --staged'
add-alias gtlsunst            'gtls.sh --unstaged'
add-alias gitalladd           'git add $(gtlsunst)'
add-alias gitallclean         'git clean -fd $(git rev-parse --show-toplevel)'
add-alias gitclean            'gitallclean -e "*.ctags_tag" -e "*.ctags_db" -e "*.c" -e "*.h" -e "*.sig"'
add-alias gitignored          'git status --ignored -u'

# ---------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------

add-alias ip-links      'ip link list'
add-alias ip-routes     'ip route list'
add-alias ip-details    '_wrap(){ ip -details -json link show $@ | jq; }; _wrap'

add-alias ipt-rules     'sudo iptables --list-rules'
add-alias ipt-nat       'sudo iptables --list --numeric --verbose --table nat'
add-alias ipt-stats     'sudo iptables --list --numeric --verbose'

add-alias scan-ports    'nmap -sS -sU -T4'

add-alias arp-flush     'sudo ip -s -s neigh flush all'

add-alias dns-status    'resolvectl status'
add-alias dns-flush     'sudo resolvectl flush-caches'

# ---------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------

# docker container
dc() {
    case "$1" in
        ls) shift
            docker container ls --format "{{.Names}}" "$@"
            ;;

        ns) shift
            local usage="Usage: dc ns <container_name> [options] [--] <command>"
            if [ -z "$1" ]; then
                echo "$usage"
                return 1
            fi
            if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
                echo "$usage"
                echo ""
                echo "Enter container namespace and execute command"
                echo ""
                echo "Examples:"
                echo "  dc ns mycontainer ip a                    # Show network interfaces"
                echo "  dc ns mycontainer --net --pid ps aux      # Show processes in container"
                echo "  dc ns mycontainer -- --help               # Run --help in container"
                echo "  dc ns mycontainer                         # Start bash in container"
                echo ""
                echo "Common options:"
                echo "  --net      Enter network namespace"
                echo "  --pid      Enter PID namespace"
                echo "  --mount    Enter mount namespace"
                echo "  --uts      Enter UTS namespace"
                echo "  --ipc      Enter IPC namespace"
                return 0
            fi
            local container="$1"
            shift
            local pid
            pid=$(docker inspect -f '{{.State.Pid}}' "$container" 2>/dev/null)
            if [ -z "$pid" ] || [ "$pid" -eq 0 ]; then
                echo "Container '$container' is not running or doesn't exist"
                return 1
            fi
            # Options starts with --
            local ns_opts=()
            local command=()
            for arg in "$@"; do
                if [[ ${#command[@]} -eq 0 ]] && [[ "$arg" == --* ]]; then
                    ns_opts+=("$arg")
                else
                    command+=("$arg")
                fi
            done
            if [[ ${#command[@]} -eq 0 ]]; then
                # shellcheck disable=SC2068
                sudo nsenter -t "$pid" ${ns_opts[@]} /bin/bash
            else
                # shellcheck disable=SC2068
                sudo nsenter -t "$pid" ${ns_opts[@]} "${command[@]}"
            fi
            ;;

        *)   docker container "$@" ;;
    esac
}

log-result "Source file ./.env/bashrc.aliases"
