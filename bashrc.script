#!/usr/bin/env bash

# REF: Utility Argument Syntax
# https://pubs.opengroup.org/onlinepubs/9699919799/basedefs/V1_chap12.html

# Generate secure password
# Arguments: none
# Return:    a 16-character password to stdout, followed by a newline
#            exit status 1 if openssl is not available or the entropy source fails
pwgen16() {
    local length=16
    local alphabet='A-Za-z0-9#%+_=?~-'
    local pwd

    if ! command -v openssl >/dev/null 2>&1; then
        echo "pwgen16: openssl not found" >&2
        return 1
    fi

    while :; do
        pwd="$(openssl rand $(( length * 32 )) 2>/dev/null \
            | LC_ALL=C tr -dc "$alphabet" \
            | head -c "$length")"

        [ "${#pwd}" -eq "$length" ] && break
    done
    printf '%s\n' "$pwd"
}
