#! /usr/bin/env bash

# shellcheck source=/dev/null
# shellcheck disable=SC2016,SC2139

# ---------------------------------------------------------------------
# Extend PATH variable
# ---------------------------------------------------------------------

if [ -z "$ENV_PATH" ]; then
    ENV_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    export ENV_PATH
fi

case ":$PATH:" in
    *":${ENV_PATH}:"*) ;;
    *) export PATH="${ENV_PATH}:$PATH" ;;
esac

case ":$PATH:" in
    *":${ENV_PATH}/bin:"*) ;;
    *) export PATH="${ENV_PATH}/bin:$PATH" ;;
esac

# ---------------------------------------------------------------------
# General functions
# ---------------------------------------------------------------------

source "${ENV_PATH}/bashrc.logging"

# ---------------------------------------------------------------------
# Common environment
# ---------------------------------------------------------------------

# --- apply color scheme ---
global_color_scheme
PS1="\t \[${SF_BOLD}\]\[${SF_GREEN}\]\u@\h \[${SF_BLUE}\]\w \[${SF_GREEN}\]\$ \[${SF_NORM}\]"

# --- source environment ---
retval=0
if [ "$retval" -eq 0 ]; then
    for file in \
        bashrc.aliases \
        bashrc.certs \
        bashrc.docker \
        bashrc.script
    do
        source "${ENV_PATH}/$file" || {
            retval=$?
            break
        }
    done
fi
if [ "$retval" -eq 0 ]; then
    for file in "${ENV_PATH}/bashrc.complete.d/"*; do
        source "$file" || {
            retval=$?
            break
        }
    done
fi
log-result "Source file bashrc.common" $retval

# ---------------------------------------------------------------------
# User environment
# ---------------------------------------------------------------------

if [ -f "${ENV_PATH}/bashrc.user" ]; then
    source "${ENV_PATH}/bashrc.user"
    log-result "Source file bashrc.user" $?
fi

# ---------------------------------------------------------------------
# Version
# ---------------------------------------------------------------------

if [ -f "${ENV_PATH}/version.env" ]; then
    source "${ENV_PATH}/version.env"
fi
