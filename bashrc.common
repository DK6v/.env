#! /usr/bin/env bash

# shellcheck source=/dev/null
# shellcheck disable=SC2016,SC2139

# ---------------------------------------------------------------------
# Extend PATH variable
# ---------------------------------------------------------------------

if [ -z "$ENV_FILE" ]; then
    export ENV_PATH=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
fi

if [[ ! "${PATH}" =~ ((^|:)${ENV_PATH}(:|$)) ]]; then
    export PATH=${ENV_PATH}:$PATH;
fi

if [[ ! "${PATH}" =~ ((^|:)${ENV_PATH}/bin(:|$)) ]]; then
    export PATH=${ENV_PATH}/bin:$PATH;
fi

# ---------------------------------------------------------------------
# Source functions
# ---------------------------------------------------------------------

source "${ENV_PATH}/bashrc.script"

# ---------------------------------------------------------------------
# Common environment
# ---------------------------------------------------------------------

# Apply color scheme
global_color_scheme;

export EDITOR="/usr/bin/vim"
PS1="\t \[${SF_BOLD}\]\[${SF_GREEN}\]\u@\h \[${SF_BLUE}\]\w \[${SF_GREEN}\]\$ \[${SF_NORM}\]"

# Mask 002 (not 000) is required to make RSA (ssh-keygen) work
umask 002

if [ -f ${ENV_PATH}/bashrc.aliases ]; then
    . ${ENV_PATH}/bashrc.aliases
fi

if [ -f ${ENV_PATH}/bashrc.complete ]; then
    . ${ENV_PATH}/bashrc.complete
fi

log-result "Source file ./.env/bashrc.common"

# ---------------------------------------------------------------------
# User environment
# ---------------------------------------------------------------------

if [ -f ${ENV_PATH}/bashrc.user ]; then
    . ${ENV_PATH}/bashrc.user
fi
