[init]
	defaultBranch = main
[core]
	editor = code --wait
[color]
	ui = auto
[diff]
	tool = kdiff3
[difftool]
	prompt = false
	keepBackup = false
	trustExitCode = false
[merge]
	tool = kdiff3
[mergetool]
	prompt = false
	keepBackup = false
	keepTemporaries = false
[include]
	path = ~/.env/gitconfig.aliases
