#! /usr/bin/env bash

# shellcheck source=/dev/null
# shellcheck disable=SC2016,SC2139

__auto_complete_dc() {
    local cur words cword
    _init_completion || return

    # If first argument is a command
    if [[ $cword -eq 1 ]]; then
        # Suggest commands
        local opts="br bridge exec inspect logs logf ls list restart rm start stop ns namespace ps"
        mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
        return 0
    fi

    # --- br / bridge command ---
    if [[ ${words[1]} == "br" || ${words[1]} == "bridge" ]]; then
        if [[ $cword -eq 2 ]]; then
            if [[ "$cur" == "-"* ]]; then
                local opts="--help"
                mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
            else
                mapfile -t COMPREPLY < <(docker network ls --format '{{.Name}}' 2>/dev/null | grep "^$cur")
            fi
        fi
        return 0
    fi

    # --- ls command ---
    if [[ ${words[1]} == "ls" ]]; then
        local opts="-a --all --filter --format"
        mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
        return 0
    fi

    # --- ns command ---
    if [[ ${words[1]} == "ns" ]]; then
        if [[ $cword -eq 2 ]]; then
            if [[ "$cur" == "-"* ]]; then
                # If typing just "dc ns -" suggest only --help
                local opts="--help"
                mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
            else
                # Suggest running containers
                mapfile -t COMPREPLY < <(docker ps --format '{{.Names}}' 2>/dev/null | grep "^$cur")
            fi
        elif [[ $cword -eq 3 ]]; then
            # After container name, suggest nsenter options
            local opts="--net --pid --mount --uts --ipc --"
            mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
        else
            # For subsequent arguments, suggest files
            mapfile -t COMPREPLY < <(compgen -f -- "$cur")
        fi
        return 0
    fi

    # --- logf command ---
    if [[ ${words[1]} == "logf" ]]; then
        if [[ "$cur" == -* ]]; then
            # option
            local opts="--out= -q --quiet -f --follow -t --timestamps --tail --since --until --details -h --help"
            mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
        else
            # container
            mapfile -t COMPREPLY < <(docker ps --format '{{.Names}}' 2>/dev/null | grep "^$cur")
        fi
        return 0
    fi

    # For other commands, suggest container names
    case "${words[1]}" in
        exec|start|stop|restart|rm|logs|inspect)
            mapfile -t COMPREPLY < <(docker ps -a --format '{{.Names}}' | grep "^$cur")
            return 0
            ;;
    esac
}
complete -F __auto_complete_dc dc
