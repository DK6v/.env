#! /usr/bin/env bash

# shellcheck source=/dev/null
# shellcheck disable=SC2016,SC2139

# ---------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------

dc() {
    case "$1" in
        ls|list)
            shift
            docker container ls --format "{{.Names}}" "$@"
            ;;

        ns|namespace)
            shift
            __dc_namespace "$@"
            ;;
        
        br|bridge)
            shift
            __dc_bridge "$@"
            ;;

        logf)
            shift
            __dc_logf "$@"
            ;;

        *)
            docker container "$@"
            ;;
    esac
}

__dc_namespace() {
    local usage="Usage: dc ns <container_name> [options] [--] <command>"
    if [ -z "$1" ]; then
        echo "$usage"
        return 1
    fi
    if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
        echo "$usage"
        echo ""
        echo "Enter container namespace and execute command"
        echo ""
        echo "Examples:"
        echo "  dc ns mycontainer ip a                    # Show network interfaces"
        echo "  dc ns mycontainer --net --pid ps aux      # Show processes in container"
        echo "  dc ns mycontainer -- --help               # Run --help in container"
        echo "  dc ns mycontainer                         # Start bash in container"
        echo ""
        echo "Common options:"
        echo "  --net      Enter network namespace"
        echo "  --pid      Enter PID namespace"
        echo "  --mount    Enter mount namespace"
        echo "  --uts      Enter UTS namespace"
        echo "  --ipc      Enter IPC namespace"
        return 0
    fi
    local container="$1"
    shift
    local pid
    pid=$(docker inspect -f '{{.State.Pid}}' "$container" 2>/dev/null)
    if [ -z "$pid" ] || [ "$pid" -eq 0 ]; then
        echo "Container '$container' is not running or doesn't exist"
        return 1
    fi
    # Options starts with --
    local ns_opts=()
    local command=()
    for arg in "$@"; do
        if [[ ${#command[@]} -eq 0 ]] && [[ "$arg" == --* ]]; then
            ns_opts+=("$arg")
        else
            command+=("$arg")
        fi
    done
    if [[ ${#command[@]} -eq 0 ]]; then
        # shellcheck disable=SC2068
        sudo nsenter -t "$pid" ${ns_opts[@]} /bin/bash
    else
        # shellcheck disable=SC2068
        sudo nsenter -t "$pid" ${ns_opts[@]} "${command[@]}"
    fi
}

__dc_bridge() {
    local usage="Usage: dc bridge <network_name>"
        if [ -z "$1" ]; then
            echo "$usage"
            return 1
        fi
        if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
            echo "$usage"
            echo ""
            echo "Print the bridge interface name for a docker network"
            echo ""
            echo "Examples:"
            echo "  dc br host                 # error: no bridge interface"
            echo "  dc br bridge               # docker0 (default bridge)"
            echo "  dc br docker_internal      # br-d331fd2b46f9"
            return 0
        fi
        local net="$1" driver id
        read -r driver id < <(docker network inspect -f '{{.Driver}} {{.Id}}' "$net" 2>/dev/null) || {
            log-error "network '$net' not found"
            return 1
        }        
        case "$driver" in
            bridge)
                if [ "$net" = bridge ]; then echo docker0
                else printf 'br-%.12s\n' "$id"
                fi
                ;;
            host|none|null)
                log-warn "network '$net' has no bridge interface (driver=$driver)"
                return 1
                ;;
            *)
                log-warn "dc bridge: unsupported driver '$driver' for network '$net'"
                return 1
                ;;
        esac
}

__dc_logf() {
    local usage="Usage: dc logf <container> [-o <file>] [--tee] [docker-native-options]"
    if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
        echo "$usage"
        echo ""
        echo "Save container logs to a file"
        echo "Default file: <container>_<timestamp>.log"
        echo ""
        echo "Custom options:"
        echo "  -o, --out <file>   Write logs to <file>"
        echo "  --tee              Also print logs to stdout"
        echo ""
        echo "Docker native options:"
        echo "  -f, --follow       Follow log output"
        echo "  -t, --timestamps   Show timestamps"
        echo "  --tail N           Only show last N lines"
        echo "  --since TIME       Show logs since TIME"
        echo "  --until TIME       Show logs before TIME"
        echo "  --details          Show extra details"
        echo ""
        echo "The container name must be the first argument."
        echo ""
        echo "Examples:"
        echo "  dc logf mycontainer                       # file only     -> mycontainer_<ts>.log"
        echo "  dc logf mycontainer --tee                 # file + stdout -> mycontainer_<ts>.log"
        echo "  dc logf mycontainer -o /tmp/my.log        # file only     -> /tmp/my.log"
        echo "  dc logf mycontainer --tee -f              # follow, file + stdout"
        echo "  dc logf mycontainer -t --tail 100 --tee   # timestamps, last 100, file + stdout"
        return 0
    fi

    # --- stdin mode: read container names, recurse per container ---

    # Enter if: stdin is not a tty AND there is no explicit container
    # (no args, or the first arg is an option, not a container).
    if [ ! -t 0 ] && { [ $# -eq 0 ] || [[ "$1" == -* ]]; }; then
        local -a names=()
        mapfile -t names
        if [ ${#names[@]} -eq 0 ]; then
            log-error "no container names on stdin"
            return 1
        fi
        local c
        for c in "${names[@]}"; do
            [ -z "$c" ] && continue
            __dc_logf "$c" "$@" </dev/null
        done
        return 0
    fi

    # --- single-container mode ---

    if [ $# -eq 0 ]; then
        echo "$usage"
        return 1
    fi

    local container="$1"
    if [[ "$container" == -* ]]; then
        log-error "container name must be the first argument"
        echo "$usage"
        return 1
    fi
    shift

    local out=""
    local use_tee=0
    local docker_opts=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -o|--out)
                if [ -z "$2" ]; then
                    log-error "option -o requires a file path"
                    return 1
                fi
                out="$2"
                shift 2
                ;;
            --tee)
                use_tee=1
                shift
                ;;
            *)
                # everything else goes to docker logs as-is
                docker_opts+=("$1")
                shift
                ;;
        esac
    done

    # default file name: <container>_<YYYY-MM-DD_HH-MM-SS>.log
    if [ -z "$out" ]; then
        out="${container}_$(date +%Y-%m-%d_%H-%M-%S).log"
    fi

    # check container exists
    if ! docker inspect "$container" >/dev/null 2>&1; then
        log-error "container '$container' not found"
        return 1
    fi

    # make sure the target directory is writable
    local out_dir
    out_dir=$(dirname -- "$out")
    if [ ! -w "$out_dir" ]; then
        log-error "cannot write to '$out_dir'"
        return 1
    fi

    if [ "$use_tee" -eq 1 ]; then
        docker logs "${docker_opts[@]}" "$container" 2>&1 | nocolor | tee -- "$out"
    else
        log-progress-start "Writing to $out"
        docker logs "${docker_opts[@]}" "$container" 2>&1 | nocolor >"$out"
        log-progress-done
    fi
}
