#! /usr/bin/env bash

# shellcheck source=/dev/null
# shellcheck disable=SC2016,SC2139

# ---------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------

# Wrapper for docker with extra commands:
#   docker container ns|namespace  - enter container namespace and execute command
#   docker container logf          - save container logs to a file
#   docker network br|bridge       - print the bridge interface name for a network
#   docker container ls -1         - list container names only
# Everything else is passed to the docker binary as is.
docker() {
    case "$1 $2" in
        "container ls"|"container list")
            __docker_ext_ls "$@"
            ;;

        "container ns"|"container namespace")
            shift 2
            __docker_ext_namespace "$@"
            ;;

        "container logf")
            shift 2
            __docker_ext_logf "$@"
            ;;

        "network br"|"network bridge")
            shift 2
            __docker_ext_bridge "$@"
            ;;

        "container --help"|"container -h"|"container ")
            command docker "$@"
            echo ""
            echo "Extra commands:"
            echo "  logf           Save container logs to a file"
            echo "  ns, namespace  Enter container namespace and execute command"
            echo ""
            echo "Extra options:"
            echo "  ls -1          List container names only (--format '{{.Names}}')"
            ;;

        "network --help"|"network -h"|"network ")
            command docker "$@"
            echo ""
            echo "Extra commands:"
            echo "  br, bridge     Print the bridge interface name for a docker network"
            ;;

        *)
            command docker "$@"
            ;;
    esac
}

# docker container ls with the extra option:
#   -1  list container names only, same as --format '{{.Names}}'
__docker_ext_ls() {
    local args=() arg
    for arg in "$@"; do
        if [ "$arg" = "-1" ]; then
            args+=(--format '{{.Names}}')
        else
            args+=("$arg")
        fi
    done
    command docker "${args[@]}"
}

__docker_ext_namespace() {
    local usage="Usage: docker container ns <container_name> [options] [--] <command>"
    if [ -z "$1" ]; then
        echo "$usage"
        return 1
    fi
    if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
        echo "$usage"
        echo ""
        echo "Enter container namespace and execute command"
        echo ""
        echo "Examples:"
        echo "  docker container ns mycontainer ip a                    # Show network interfaces"
        echo "  docker container ns mycontainer --net --pid ps aux      # Show processes in container"
        echo "  docker container ns mycontainer -- --help               # Run --help in container"
        echo "  docker container ns mycontainer                         # Start bash in container"
        echo ""
        echo "Common options:"
        echo "  --net      Enter network namespace"
        echo "  --pid      Enter PID namespace"
        echo "  --mount    Enter mount namespace"
        echo "  --uts      Enter UTS namespace"
        echo "  --ipc      Enter IPC namespace"
        return 0
    fi
    local container="$1"
    shift
    local pid
    pid=$(docker inspect -f '{{.State.Pid}}' "$container" 2>/dev/null)
    if [ -z "$pid" ] || [ "$pid" -eq 0 ]; then
        echo "Container '$container' is not running or doesn't exist"
        return 1
    fi
    # Options starts with --
    local ns_opts=()
    local command=()
    for arg in "$@"; do
        if [[ ${#command[@]} -eq 0 ]] && [[ "$arg" == --* ]]; then
            ns_opts+=("$arg")
        else
            command+=("$arg")
        fi
    done
    if [[ ${#command[@]} -eq 0 ]]; then
        # shellcheck disable=SC2068
        sudo nsenter -t "$pid" ${ns_opts[@]} /bin/bash
    else
        # shellcheck disable=SC2068
        sudo nsenter -t "$pid" ${ns_opts[@]} "${command[@]}"
    fi
}

__docker_ext_bridge() {
    local usage="Usage: docker network bridge <network_name>"
        if [ -z "$1" ]; then
            echo "$usage"
            return 1
        fi
        if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
            echo "$usage"
            echo ""
            echo "Print the bridge interface name for a docker network"
            echo ""
            echo "Examples:"
            echo "  docker network br host                 # error: no bridge interface"
            echo "  docker network br bridge               # docker0 (default bridge)"
            echo "  docker network br docker_internal      # br-d331fd2b46f9"
            return 0
        fi
        local net="$1" driver id
        read -r driver id < <(docker network inspect -f '{{.Driver}} {{.Id}}' "$net" 2>/dev/null) || {
            log-error "network '$net' not found"
            return 1
        }        
        case "$driver" in
            bridge)
                if [ "$net" = bridge ]; then echo docker0
                else printf 'br-%.12s\n' "$id"
                fi
                ;;
            host|none|null)
                log-warn "network '$net' has no bridge interface (driver=$driver)"
                return 1
                ;;
            *)
                log-warn "docker network bridge: unsupported driver '$driver' for network '$net'"
                return 1
                ;;
        esac
}

__docker_ext_logf() {
    local usage="Usage: docker container logf <container> [-o <file>] [--tee] [docker-native-options]"
    if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
        echo "$usage"
        echo ""
        echo "Save container logs to a file"
        echo "Default file: <container>_<timestamp>.log"
        echo ""
        echo "Custom options:"
        echo "  -o, --out <file>   Write logs to <file>"
        echo "  --tee              Also print logs to stdout"
        echo ""
        echo "Docker native options:"
        echo "  -f, --follow       Follow log output"
        echo "  -t, --timestamps   Show timestamps"
        echo "  --tail N           Only show last N lines"
        echo "  --since TIME       Show logs since TIME"
        echo "  --until TIME       Show logs before TIME"
        echo "  --details          Show extra details"
        echo ""
        echo "The container name must be the first argument."
        echo ""
        echo "Examples:"
        echo "  docker container logf mycontainer                       # file only     -> mycontainer_<ts>.log"
        echo "  docker container logf mycontainer --tee                 # file + stdout -> mycontainer_<ts>.log"
        echo "  docker container logf mycontainer -o /tmp/my.log        # file only     -> /tmp/my.log"
        echo "  docker container logf mycontainer --tee -f              # follow, file + stdout"
        echo "  docker container logf mycontainer -t --tail 100 --tee   # timestamps, last 100, file + stdout"
        echo ""
        echo "Container names can also be read from stdin:"
        echo "  docker container ls -1 | docker container logf --tee"
        return 0
    fi

    # --- stdin mode: read container names, recurse per container ---

    # Enter if: stdin is not a tty AND there is no explicit container
    # (no args, or the first arg is an option, not a container).
    if [ ! -t 0 ] && { [ $# -eq 0 ] || [[ "$1" == -* ]]; }; then
        local -a names=()
        mapfile -t names
        if [ ${#names[@]} -eq 0 ]; then
            log-error "no container names on stdin"
            return 1
        fi
        local c
        for c in "${names[@]}"; do
            [ -z "$c" ] && continue
            __docker_ext_logf "$c" "$@" </dev/null
        done
        return 0
    fi

    # --- single-container mode ---

    if [ $# -eq 0 ]; then
        echo "$usage"
        return 1
    fi

    local container="$1"
    if [[ "$container" == -* ]]; then
        log-error "container name must be the first argument"
        echo "$usage"
        return 1
    fi
    shift

    local out=""
    local use_tee=0
    local docker_opts=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -o|--out)
                if [ -z "$2" ]; then
                    log-error "option -o requires a file path"
                    return 1
                fi
                out="$2"
                shift 2
                ;;
            --tee)
                use_tee=1
                shift
                ;;
            *)
                # everything else goes to docker logs as-is
                docker_opts+=("$1")
                shift
                ;;
        esac
    done

    # default file name: <container>_<YYYY-MM-DD_HHhMMmSSs>.log
    if [ -z "$out" ]; then
        out="${container}_$(date +%Y-%m-%d_%Hh%Mm%Ss).log"
    fi

    # check container exists
    if ! docker inspect "$container" >/dev/null 2>&1; then
        log-error "container '$container' not found"
        return 1
    fi

    # make sure the target directory is writable
    local out_dir
    out_dir=$(dirname -- "$out")
    if [ ! -w "$out_dir" ]; then
        log-error "cannot write to '$out_dir'"
        return 1
    fi

    if [ "$use_tee" -eq 1 ]; then
        docker logs "${docker_opts[@]}" "$container" 2>&1 | nocolor | tee -- "$out"
    else
        log-progress-start "Writing to $out"
        docker logs "${docker_opts[@]}" "$container" 2>&1 | nocolor >"$out"
        log-progress-done
    fi
}
