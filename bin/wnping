#!/usr/bin/env bash

readonly nping="/usr/bin/nping"

: "${ENV_PATH:?set to the path of the common environment (e.g. \$HOME/.env)}"
source "${ENV_PATH}/bashrc.logging"

# LOG_LEVEL='debug'

# Apply color scheme, see ~/.env/bashrc.common for details.
global_color_scheme;

# Include result codes
global_result_codes

function main() {

  local DIRECT_OPTS=()

  local IP_ADDR=""
  local MAC_ADDR=""

  if ! type "$nping" >/dev/null 2>&1; then
    log-warn "Command 'nping' needs to be installed, terminating..."
    exit "$ENOPKG"
  fi

  while (($#)); do
    local opt=$1
    case $opt in
      -s|--source)
          if [ $# -lt 2 ]; then
            log-error "IP address is not specified"
            exit "$ENOARG"
          fi
          IP_ADDR=$2
          shift 2
          ;;
      -h|--help)
          exec nping --help
          exit "$ENOERR"
          ;;
      *)
          DIRECT_OPTS+=("$opt")
          shift
          ;;
      esac
  done

  if [ -n "$IP_ADDR" ] &&
     [[ ! "$IP_ADDR" =~ (^([0-9]{1,3}\.){3}[0-9]{1,3}$) ]]; then
    log-error "Invalid IPv4 address"
    exit "$EINVAL"
  fi

  # Find the source MAC address
  if [ -n "$IP_ADDR" ]; then
    MAC_ADDR=$(ip-to-mac "$IP_ADDR")
  fi

  log-debug "Source address: IP=$IP_ADDR MAC=$MAC_ADDR"
  log-debug "Direct options: ${DIRECT_OPTS[*]}"

  # Prepare wrapped command
  local cmd=(sudo nping)
  if [ -n "$IP_ADDR" ] && [ -n "$MAC_ADDR" ]; then
    cmd+=(--source-ip "$IP_ADDR" --source-mac "$MAC_ADDR")
  elif [ -n "$IP_ADDR" ]; then
    log-warn "The source MAC address was not found. Default values will be used instead."
  fi
  cmd+=("${DIRECT_OPTS[@]}")

  log-info "Wrapped command: \"${cmd[*]}\""
  exec "${cmd[@]}"
}

main "$@"
exit $?
